{
  "name": "react-tw-breakpoints",
  "version": "1.2.3",
  "description": "useBreakpoint hooks and tw-based components.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarlosEGuerraSilva/react-tw-breakpoints.git"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --minify",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "sideEffects": false,
  "keywords": [
    "react",
    "tailwind",
    "tailwind4",
    "breakpoints"
  ],
  "author": "CarlosEGuerraSilva",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "happy-dom": "^20.0.7",
    "jsdom": "^27.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  }
}
